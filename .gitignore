# Commit only source, configuration, tests and documentation.
# Everything below is downloaded, generated, local or secret, and is recreated by the documented commands.

# ---- Data (Kaggle download, SQLite databases, Parquet history, simulation exports, reports) ----
data/
# Trained model artifacts ARE committed (models/cooling_response/, ~1.2 MB) so a fresh clone can serve
# forecasts without retraining. Only half-written training output is ignored.
models/**/.tmp-*/
models/**/ACTIVE.tmp
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.parquet
*.parquet.tmp

# ---- Logs ----
logs/
*.log
*.jsonl

# ---- Secrets and local environment ----
.env
.env.*
!.env.example
kaggle.json
access_token
*.pem
*.key

# ---- Python / uv ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# ---- Generated tooling output ----
graphify-out/

# ---- Claude Code: keep project skills, ignore personal settings ----
.claude/settings.local.json

# ---- Personal interview preparation (kept local, never committed) ----
docs/INTERVIEW_GUIDE.md

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
