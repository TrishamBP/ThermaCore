# API_COPILOT_MAX_TURNS=10
# API_COPILOT_CONVERSATION_TTL_S=3600
# API_TWIN_POLL_INTERVAL_S=10      # one shared poll for all SSE subscribers
# API_TWIN_HEARTBEAT_S=15
# API_TWIN_MAX_SUBSCRIBERS=50
# DIGITAL_TWIN_LAYOUT=config/digital_twin_layout.yaml
