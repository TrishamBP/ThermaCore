# Copy to .env to override defaults:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Never commit .env. This file contains no secrets and none are needed for local development.
# Every value below is the built-in default (see src/data_engineering/streaming/settings.py),
# so an empty .env behaves exactly like this file. Real environment variables and CLI flags
# take precedence over .env.

# ---- Kafka connection ----
# 127.0.0.1 rather than localhost: on Windows, localhost resolves to IPv6 ::1 first, which the
# Docker broker does not listen on (each attempt costs ~2 s).
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_TOPIC=datacenter.telemetry
KAFKA_CLIENT_ID=dco-telemetry-producer

# ---- Delivery semantics ----
KAFKA_ACKS=all                       # wait for all in-sync replicas (1 replica locally)
KAFKA_ENABLE_IDEMPOTENCE=true        # no duplicates/reordering from the client's own retries
KAFKA_DELIVERY_TIMEOUT_MS=120000     # total time librdkafka may retry one message before failing it
KAFKA_REQUEST_TIMEOUT_MS=30000       # per produce request
KAFKA_RETRY_BACKOFF_MS=100

# ---- Batching / throughput ----
KAFKA_LINGER_MS=20                   # wait up to 20 ms to fill a batch
KAFKA_BATCH_SIZE_BYTES=65536
KAFKA_COMPRESSION_TYPE=lz4           # none | gzip | snappy | lz4 | zstd
KAFKA_QUEUE_MAX_MESSAGES=100000      # local buffer size before produce() waits

# ---- Producer behaviour ----
KAFKA_FLUSH_TIMEOUT_S=30             # how long to wait for outstanding deliveries on exit
KAFKA_METADATA_TIMEOUT_S=10          # broker/topic pre-flight check
PRODUCER_RATE_EVENTS_PER_S=0         # 0 = unthrottled (CLI: --rate)
PRODUCER_SPEEDUP=0                   # simulated seconds per real second, 0 = off (CLI: --speedup)

# ---- Topic creation (topic_setup) ----
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000   # 7 days

# ---- Other ----
# DATACENTER_OPS_DB_PATH=data/datacenter_ops.db   # SQLite database (Phase 1)
# Kaggle download works anonymously; only if Kaggle asks for authentication:
# KAGGLE_API_TOKEN=

# =============================================================== consumer (Kafka -> store)
# Shared with the producer: KAFKA_BOOTSTRAP_SERVERS, KAFKA_TOPIC, KAFKA_METADATA_TIMEOUT_S (above).
KAFKA_DLQ_TOPIC=datacenter.telemetry.dlq
KAFKA_GROUP_ID=dco-telemetry-sink          # stable: offsets are tracked per group
KAFKA_CONSUMER_CLIENT_ID=dco-telemetry-consumer
KAFKA_AUTO_OFFSET_RESET=earliest           # where a NEW group starts; committed offsets always win
KAFKA_SESSION_TIMEOUT_MS=45000
KAFKA_MAX_POLL_INTERVAL_MS=300000          # must exceed the worst-case retry time of one batch
# Auto-commit is always off (offsets are committed only after persistence); not configurable.

CONSUMER_BATCH_MAX_MESSAGES=1000           # one DB transaction per batch
CONSUMER_BATCH_MAX_WAIT_S=2
CONSUMER_MAX_RETRIES=5                     # transient DB / DLQ / commit errors
CONSUMER_RETRY_BACKOFF_INITIAL_S=0.5       # exponential backoff with jitter ...
CONSUMER_RETRY_BACKOFF_MAX_S=10            # ... capped here
CONSUMER_DLQ_FLUSH_TIMEOUT_S=10            # wait this long for DLQ broker confirmation
CONSUMER_SHUTDOWN_TIMEOUT_S=30

# ---- Telemetry store (separate from the Phase 1 database) ----
TELEMETRY_DB_BACKEND=sqlite                # sqlite | postgres
TELEMETRY_SQLITE_PATH=data/telemetry_store.db
# TELEMETRY_POSTGRES_URL=postgresql://dco:CHANGE_ME@127.0.0.1:55432/dco

# ---- Optional local PostgreSQL (docker compose --profile postgres up -d --wait postgres) ----
# No default password on purpose; the container refuses to start without one.
# POSTGRES_USER=dco
# POSTGRES_DB=dco
# POSTGRES_PASSWORD=CHANGE_ME
# For tests against it: TELEMETRY_TEST_POSTGRES_URL=postgresql://dco:CHANGE_ME@127.0.0.1:55432/dco

# ---- Parquet history ----
PARQUET_ENABLED=true
PARQUET_OUTPUT_DIR=data/telemetry
PARQUET_PARTITION_STRATEGY=region_date     # region_date -> region_code=NA/event_date=YYYY-MM-DD ; date -> event_date=...
PARQUET_FLUSH_ROWS=50000                   # export when this many rows are waiting ...
PARQUET_FLUSH_INTERVAL_S=60                # ... or the oldest waiting batch is this old (and always at shutdown)
PARQUET_MAX_ROWS_PER_FILE=250000
PARQUET_COMPRESSION=zstd                   # zstd | snappy | gzip | none

LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR

# ---- API (uv run uvicorn app.main:app) ----
# The API reads the same TELEMETRY_* database settings as the consumer (above).
API_ENVIRONMENT=development               # development | test | production
API_DOCS_ENABLED=true                     # /docs, /redoc, /openapi.json
API_DB_CONNECT_TIMEOUT_S=3                # PostgreSQL connect timeout per request
API_THREADPOOL_TOKENS=40                  # concurrent sync handlers
# API_CORS_ORIGINS=["http://localhost:5173"]   # JSON list; unset = CORS disabled
# COOLING_STATE_CONFIG=config/cooling_state.yaml
