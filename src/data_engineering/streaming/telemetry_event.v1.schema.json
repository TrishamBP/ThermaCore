{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dco:schema:telemetry-event:1.0",
  "title": "Data center telemetry event (schema_version 1.0)",
  "description": "One reading slot for one simulated asset. All metric values are SYNTHETIC (generated by this project from North American rows of an engineered synthetic Kaggle dataset). They are not real operational telemetry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_timestamp", "timestamp_source", "asset_id",
    "data_center_id", "region", "region_code", "source_type", "simulation_run_id",
    "slot_index", "reading_status", "metrics", "asset_attributes", "labels", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {
      "description": "Deterministic: <simulation_run_id>:<asset_id>:<slot_index>. The same reading always gets the same ID, so consumers can deduplicate.",
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+:[A-Za-z0-9._-]+:[0-9]+$"
    },
    "event_timestamp": {
      "description": "Simulated measurement time (UTC, ISO-8601, second precision, trailing Z). Not the publish time.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "timestamp_source": {"const": "simulated"},
    "asset_id": {"description": "Synthetic asset identifier (SIM-<region_code>-NNN). The source dataset has no asset IDs.", "type": "string", "minLength": 1},
    "data_center_id": {"description": "Identifier of the single hypothetical data center (from config/simulation.yaml).", "type": "string", "minLength": 1},
    "region": {"description": "Human-readable region; mapping from region_code is inferred (NA -> North America).", "type": "string", "minLength": 1},
    "region_code": {"description": "datacenter_region value of the baseline source rows.", "type": "string", "minLength": 1},
    "source_type": {"description": "Origin of the measurements. Only 'simulated' exists in this version.", "const": "simulated"},
    "simulation_run_id": {"type": "string", "minLength": 1},
    "slot_index": {"description": "0-based slot number from the simulation start; slot_index * frequency_seconds = offset from start.", "type": "integer", "minimum": 0},
    "reading_status": {"description": "'missing' = the slot exists but no reading was produced; all metrics are null.", "enum": ["observed", "missing"]},
    "metrics": {
      "description": "Simulated measurements. Units are inferred from source column names; the dataset does not document units.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_intensity", "cpu_utilization", "gpu_utilization", "memory_utilization",
        "storage_utilization", "disk_io_iops", "network_throughput_gbps", "network_latency_ms",
        "ambient_temperature_c", "humidity_percentage", "inlet_temperature_c",
        "exhaust_temperature_c", "fan_speed_rpm", "airflow_cfm", "power_consumption_kw", "pue"
      ],
      "properties": {
        "workload_intensity": {"type": ["number", "null"], "description": "unitless, source range 0.1-1.0"},
        "cpu_utilization": {"type": ["number", "null"], "description": "percent (inferred from 0-100 source range)"},
        "gpu_utilization": {"type": ["number", "null"], "description": "percent (inferred from 0-100 source range); 0 for non-GPU servers"},
        "memory_utilization": {"type": ["number", "null"], "description": "percent (inferred from 0-100 source range)"},
        "storage_utilization": {"type": ["number", "null"], "description": "percent (inferred from 0-100 source range)"},
        "disk_io_iops": {"type": ["number", "null"], "description": "I/O operations per second (from column name)"},
        "network_throughput_gbps": {"type": ["number", "null"], "description": "Gbit/s (from column name)"},
        "network_latency_ms": {"type": ["number", "null"], "description": "milliseconds (from column name)"},
        "ambient_temperature_c": {"type": ["number", "null"], "description": "degrees Celsius (from column name)"},
        "humidity_percentage": {"type": ["number", "null"], "description": "percent (from column name)"},
        "inlet_temperature_c": {"type": ["number", "null"], "description": "degrees Celsius (from column name)"},
        "exhaust_temperature_c": {"type": ["number", "null"], "description": "degrees Celsius (from column name)"},
        "fan_speed_rpm": {"type": ["number", "null"], "description": "revolutions per minute (from column name)"},
        "airflow_cfm": {"type": ["number", "null"], "description": "cubic feet per minute (from column name)"},
        "power_consumption_kw": {"type": ["number", "null"], "description": "kilowatts (from column name)"},
        "pue": {"type": ["number", "null"], "description": "power usage effectiveness, unitless ratio"}
      }
    },
    "asset_attributes": {
      "description": "Static attributes copied unchanged from the asset's baseline source row.",
      "type": "object",
      "additionalProperties": false,
      "required": ["server_type", "cooling_type", "server_age_years", "rack_u_position", "energy_source_primary"],
      "properties": {
        "server_type": {"type": "string"},
        "cooling_type": {"type": ["string", "null"]},
        "server_age_years": {"type": ["integer", "null"]},
        "rack_u_position": {"type": ["integer", "null"]},
        "energy_source_primary": {"type": ["string", "null"]}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_failure_risk_level", "source_energy_efficiency_class", "source_maintenance_status", "injected_anomalies"],
      "properties": {
        "source_failure_risk_level": {"description": "Label of the baseline source row (static; not re-assessed per minute).", "type": ["string", "null"]},
        "source_energy_efficiency_class": {"description": "Label of the baseline source row (static).", "type": ["string", "null"]},
        "source_maintenance_status": {"description": "Attribute of the baseline source row (static).", "type": ["string", "null"]},
        "injected_anomalies": {
          "description": "Anomalies deliberately injected by the simulator at this slot (ground truth). Empty when none.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["anomaly_id", "anomaly_type", "affected_metrics"],
            "properties": {
              "anomaly_id": {"type": "string", "minLength": 1},
              "anomaly_type": {"type": "string", "minLength": 1},
              "affected_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "source_file", "source_sha256", "baseline_source_row_number", "generator",
                   "generator_version", "seed", "published_from", "field_sources"],
      "properties": {
        "dataset": {"type": "string"},
        "source_file": {"type": "string"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "baseline_source_row_number": {"type": "integer", "minimum": 1},
        "generator": {"type": "string"},
        "generator_version": {"type": "string"},
        "seed": {"type": "integer"},
        "published_from": {"description": "'simulator' = generated while publishing; 'stored_run' = read back from the SQLite simulation run.", "enum": ["simulator", "stored_run"]},
        "field_sources": {
          "description": "Where each part of the event comes from: source_dataset = copied from the Kaggle rows, transformed = derived from source values, simulated = generated.",
          "const": {
            "metrics": "simulated",
            "event_timestamp": "simulated",
            "asset_id": "simulated",
            "data_center_id": "simulated",
            "region_code": "source_dataset",
            "region": "transformed",
            "asset_attributes": "source_dataset",
            "source_labels": "source_dataset",
            "injected_anomalies": "simulated"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"reading_status": {"const": "missing"}}},
      "then": {"properties": {
        "metrics": {"additionalProperties": {"type": "null"}},
        "labels": {"properties": {"injected_anomalies": {"maxItems": 0}}}
      }}
    },
    {
      "if": {"properties": {"reading_status": {"const": "observed"}}},
      "then": {"properties": {"metrics": {"additionalProperties": {"type": "number"}}}}
    }
  ]
}
